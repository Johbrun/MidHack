# ─── Build stage: build the React client ───
FROM node:22-alpine AS client-build

WORKDIR /build
# Le client importe du code partagé (@shared → shared/).
COPY shared/ ./shared/
COPY client/package.json client/package-lock.json ./client/
RUN cd client && npm ci

COPY client/ ./client/
ARG VITE_NANTES_HACK=0
ENV VITE_NANTES_HACK=$VITE_NANTES_HACK
RUN cd client && npm run build

# ─── Deps stage: better-sqlite3 is compiled for Alpine/musl ───
# Les outils de compilation restent dans cette étape : l'image finale ne les
# embarque pas.
FROM node:22-alpine AS server-deps

RUN apk add --no-cache python3 make g++
WORKDIR /build/server
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --build-from-source

# ─── Runtime stage: Express serving the built client + vulnerable API ───
FROM node:22-alpine

WORKDIR /app
COPY --from=server-deps /build/server/node_modules ./server/node_modules
COPY server/package.json ./server/
COPY server/src ./server/src
COPY server/public ./server/public
# Cible du challenge Path Traversal : doit rester à côté de public/.
COPY server/secret_flag.txt ./server/
COPY shared/ ./shared/
COPY --from=client-build /build/client/dist ./client/dist

# SQLite crée banana_shop.db (et ses -wal/-shm) dans /app/server : seul ce
# dossier appartient à l'utilisateur non privilégié.
RUN chown node:node /app/server
USER node

EXPOSE 3000
ENV PORT=3000
CMD ["node", "server/src/index.js"]
