# ─────────────────────────────────────────────────────────────
# BananaShop CTF — configuration de l'événement
# Copiez ce fichier en .env et ajustez les valeurs : cp .env.example .env
#
# TOUTE la configuration de l'événement se fait ICI.
# setup.sh lit ce fichier pour générer docker-compose.yml.
# (Les mots de passe des équipes et de l'admin sont générés
#  aléatoirement à chaque « ./setup.sh deploy » — voir credentials.json.)
# ─────────────────────────────────────────────────────────────

# ── Équipes ───────────────────────────────────────────────────
# Nombre d'équipes à générer (de 1 jusqu'au nombre de noms ci-dessous).
TEAMS=4

# Noms d'équipes, séparés par des espaces.
# Le nombre de noms détermine le maximum d'équipes possible.
TEAM_NAMES="Alpha Bravo Charlie Delta Echo Foxtrot Golf Hotel India Juliet Kilo Lima Mike November Oscar Papa Quebec Romeo Sierra Tango"

# ── Réseau ────────────────────────────────────────────────────
# Port de départ exposé sur l'hôte. Les ports sont attribués de
# façon contiguë à partir de cette valeur :
#   dashboard      = START_PORT
#   team1 site     = START_PORT + 1
#   team1 exploit  = START_PORT + 2
#   team2 site     = START_PORT + 3, etc.
START_PORT=44001

# ── Dashboard / événement ─────────────────────────────────────
EVENT_TITLE="BananaShop CTF"   # Titre affiché sur le dashboard
HINT_PENALTY=5                 # Points retirés par indice utilisé

# ── Build frontend (préfixe VITE_ obligatoire) ────────────────
VITE_NANTES_HACK=1              # 1 = branding Nantes@Hack activé, 0 = désactivé
VITE_PROGRESSIVE_UNLOCK=false   # true = niveaux débloqués progressivement
VITE_UNLOCK_THRESHOLD=2         # challenges à résoudre pour passer au niveau suivant
